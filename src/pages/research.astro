---
/**
 * Research Page
 *
 * Display projects where tabs includes "research"
 * Use ListItem component
 * Same layout as Home page projects section
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import ListItem from '../components/ListItem.astro';
import { getCollection } from 'astro:content';

const lang = 'en';

// Get all English projects where tabs includes "research", exclude drafts
const researchProjects = await getCollection('projects', ({ data }) => {
  return !data.isDraft && data.lang === lang && data.tabs.includes('research');
});

// Sort by publishDate (newest first)
const sortedProjects = researchProjects.sort((a, b) =>
  b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<BaseLayout title="Research - Portfolio" description="Research projects and publications" lang={lang}>
  <Navigation />

  <main class="min-h-screen bg-white dark:bg-gray-900 transition-colors duration-300">
    <section class="max-w-7xl mx-auto px-6 lg:px-8 py-12">
      <h1 class="text-hero-subtitle text-gray-900 dark:text-white mb-12">
        Research
      </h1>

      {sortedProjects.length > 0 ? (
        <div class="space-y-0">
          {sortedProjects.map((project) => (
            <ListItem
              title={project.data.title}
              coverImage={project.data.coverImage}
              description={project.data.description}
              tags={project.data.tags}
              slug={project.slug}
              lang={lang}
            />
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-body text-gray-500 dark:text-gray-400">
            No research projects available yet.
          </p>
        </div>
      )}
    </section>
  </main>

  <Footer />
</BaseLayout>
