---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import NetworkCanvas from '../components/NetworkCanvas.astro';

---

<BaseLayout title="Network Visualization">
  <section class="hero-section">
    <!-- Canvas 背景層 -->
    <div class="canvas-layer">
      <NetworkCanvas />
    </div>

    <!-- 內容層 -->
    <div class="content-layer">
      <!-- Navigation -->
      <nav class="nav-area">
        <Navigation />
      </nav>

      <!-- 中間留白 - 讓 network 可見 -->
      <div class="spacer"></div>

      <!-- 底部文字區 -->
      <div class="text-area">
        <!-- Top Line -->
        <div class="border-t border-gray-300 dark:border-gray-700">
          <p class="meta-text px-6 py-2">
            iOS & WEB
          </p>
        </div>

        <!-- Large Title -->
        <div class="px-6 py-4">
          <h1 class="hero-title">DEVELOPER</h1>
        </div>

        <!-- Bottom Line -->
        <div class="border-t border-gray-300 dark:border-gray-700">
          <p class="meta-text px-6 py-2">
            Aside from coding, I do research in social network analysis and AI.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    position: relative;
    height: 100dvh;
    overflow: hidden;
    background: #f5f5f0;
  }

  /* Canvas 絕對定位填滿整個區域 */
  .canvas-layer {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  /* 確保 canvas 填滿 */
  .canvas-layer :global(canvas),
  .canvas-layer :global(> *) {
    width: 100%;
    height: 100%;
  }

  /* 內容層疊在 canvas 上 */
  .content-layer {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    pointer-events: none;
  }

  /* Navigation 區域 */
  .nav-area {
    flex-shrink: 0;
    pointer-events: auto;
  }

  /* 中間彈性空白 */
  .spacer {
    flex: 1;
  }

  /* 底部文字區 */
  .text-area {
    flex-shrink: 0;
    background: linear-gradient(to top, 
      rgba(255,255,255, 0.95) 70%, 
      rgba(255,255,255, 0) 100%
    );
    pointer-events: auto;
  }

  /* Dark mode 背景 */
  :global(.dark) .text-area {
    background: linear-gradient(to top, 
      rgba(17, 24, 39, 0.95) 70%, 
      rgba(17, 24, 39, 0) 100%
    );
  }

  .meta-text {
    font-size: clamp(0.625rem, 1.2vw, 0.75rem);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #666;
    margin: 0;
  }

  :global(.dark) .meta-text {
    color: #9ca3af;
  }

  /* 關鍵：用 clamp 讓標題自適應 */
  .hero-title {
    font-family: 'Futura PT', 'Futura', system-ui, sans-serif;
    font-weight: 600;
    font-size: clamp(2rem, 10vw, 8rem);
    line-height: 0.9;
    margin: 0;
    color: #0a0a0a;
  }

  :global(.dark) .hero-title {
    color: #fff;
  }
</style>