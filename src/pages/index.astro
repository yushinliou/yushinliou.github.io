---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n/translations';

const t = useTranslations('en');

// Get all projects and filter by 'work' category and English language
const allProjects = await getCollection('projects', ({ data }) => {
  return data.categories.includes('work') && data.lang === 'en';
});

// Sort by featured first, then by publish date (newest first)
const sortedProjects = allProjects.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return b.data.publishDate.getTime() - a.data.publishDate.getTime();
});

// Transform to format expected by ProjectGrid component
const projects = sortedProjects.map((project) => ({
  title: project.data.title,
  image: project.data.image,
  link: `/projects/${project.slug}`,
  category: project.data.tags?.[0] || 'Project',
}));
---

<BaseLayout title={t.pageTitle.work} lang="en">
  <Navigation />
  <main class="flex-1 w-full">
    <div class="max-w-7xl mx-auto px-8">
      <ProjectGrid projects={projects} />
    </div>
  </main>
  <Footer />
</BaseLayout>
