---
/**
 * Individual Project Page (Chinese)
 * Same as English version
 */

import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navigation from '../../../components/Navigation.astro';
import Footer from '../../../components/Footer.astro';
import TableOfContents from '../../../components/TableOfContents.astro';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects', ({ data }) => data.lang === 'zh');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content, headings } = await project.render();
---

<BaseLayout title={project.data.title} description={project.data.description} lang={project.data.lang}>
  <Navigation />

  <main class="min-h-screen bg-white dark:bg-gray-900 transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-12">
      <div class="flex flex-col lg:flex-row gap-12">
        <!-- Project Content (70% width on desktop) -->
        <article class="flex-1 lg:max-w-[70%]">
          <!-- Cover Image -->
          {project.data.coverImage && (
            <div class="mb-8 rounded-lg overflow-hidden bg-gray-100 dark:bg-gray-800">
              <img
                src={project.data.coverImage.src.src}
                alt={project.data.coverImage.alt}
                class="w-full aspect-video object-cover"
              />
            </div>
          )}

          <!-- Project Header -->
          <header class="mb-8">
            <h1 class="text-hero-subtitle text-gray-900 dark:text-white mb-4">
              {project.data.title}
            </h1>

            {project.data.description && (
              <p class="text-body text-gray-600 dark:text-gray-400 mb-6">
                {project.data.description}
              </p>
            )}

            <!-- Metadata -->
            <div class="flex flex-wrap gap-4 text-small text-gray-500 dark:text-gray-400 mb-4">
              {project.data.publishDate && (
                <span>
                  發布日期: {project.data.publishDate.toLocaleDateString('zh-TW', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </span>
              )}
              {project.data.year && <span>年份: {project.data.year}</span>}
              {project.data.role && <span>角色: {project.data.role}</span>}
              {project.data.category && (
                <span class="px-3 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded-full">
                  {project.data.category}
                </span>
              )}
            </div>

            <!-- Tags -->
            {project.data.tags && project.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mb-6">
                {project.data.tags.map((tag) => (
                  <span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-small">
                    #{tag}
                  </span>
                ))}
              </div>
            )}

            <!-- External Links -->
            {(project.data.link || project.data.github) && (
              <div class="flex gap-4">
                {project.data.link && (
                  <a
                    href={project.data.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center px-4 py-2 text-small font-medium text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-800 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors duration-200"
                  >
                    <i class="fas fa-external-link-alt mr-2"></i>
                    查看專案
                  </a>
                )}
                {project.data.github && (
                  <a
                    href={project.data.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center px-4 py-2 text-small font-medium text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-800 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors duration-200"
                  >
                    <i class="fab fa-github mr-2"></i>
                    GitHub
                  </a>
                )}
              </div>
            )}
          </header>

          <!-- Project Content (Markdown) -->
          <div class="prose prose-lg dark:prose-invert max-w-none">
            <Content />
          </div>
        </article>

        <!-- Table of Contents Sidebar -->
        <aside class="lg:w-[30%] flex-shrink-0">
          <TableOfContents headings={headings} />
        </aside>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
