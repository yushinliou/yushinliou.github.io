---
/**
 * Home Page (Chinese)
 *
 * Same structure as English version but for Chinese language
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import ListItem from '../../components/ListItem.astro';
import NetworkPreview from '../network-preview.astro';
import { getCollection } from 'astro:content';

const lang = 'zh';

// Get all Chinese projects where tabs includes "home", exclude drafts
const featuredProjects = await getCollection('projects', ({ data }) => {
  return !data.isDraft && data.lang === lang && data.tabs.includes('home');
});

// Sort by publishDate (newest first)
const sortedProjects = featuredProjects.sort((a, b) =>
  b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<BaseLayout title="作品集 - 首頁" description="精選作品" lang={lang}>

  <NetworkPreview />

  <main class="min-h-screen bg-white dark:bg-gray-900 transition-colors duration-300">
    <!-- Hero Section -->
    <!-- <Hero lang={lang} /> -->

    <!-- Featured Projects Section -->
    <section class="max-w-7xl mx-auto px-6 lg:px-8 py-12">
      <!-- <h2 class="text-hero-subtitle text-gray-900 dark:text-white mb-12">
        精選作品
      </h2> -->

      {sortedProjects.length > 0 ? (
        <div class="space-y-0">
          {sortedProjects.map((project) => (
            <ListItem
              title={project.data.title}
              coverImage={project.data.coverImage}
              description={project.data.description}
              tags={project.data.tags}
              slug={project.slug}
              lang={lang}
            />
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-body text-gray-500 dark:text-gray-400">
            目前沒有精選作品。
          </p>
        </div>
      )}
    </section>
  </main>

  <Footer />
</BaseLayout>
