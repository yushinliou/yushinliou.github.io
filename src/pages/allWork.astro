---
/**
 * All Work Page
 *
 * Purpose: Complete portfolio with filtering capability
 *
 * Features:
 * - Tag filter at top (small screen) or left sidebar (wide screen)
 * - Tags collected from all non-draft projects
 * - Initial state: "All Categories" (shows all projects)
 * - Click tag → filter projects by selected tag
 * - Only one tag selectable at a time
 * - Selected tag: color change to black (light mode) / white (dark mode)
 * - Hover effect: background color change to gray
 *
 * Project Grid:
 * - Use Card component
 * - Display ALL projects (regardless of tabs value)
 * - Exclude only drafts (isDraft: true)
 * - Sort by publishDate (newest first)
 * - Exclude projects not in current language
 *
 * Responsive:
 * - Wide Desktop: 4 columns
 * - Normal Desktop: 3 columns
 * - Tablet: 2 columns
 * - Mobile: 1 column
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';

const lang = 'en';

// Get all English projects, exclude drafts
const allProjects = await getCollection('projects', ({ data }) => {
  return !data.isDraft && data.lang === lang;
});

// Sort by publishDate (newest first)
const sortedProjects = allProjects.sort((a, b) =>
  b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

// Collect all unique tags
const allTags = [...new Set(sortedProjects.flatMap(project => project.data.tags))];
---

<BaseLayout title="All Work - Portfolio" description="Complete portfolio of all projects" lang={lang}>
  <Navigation />

  <main class="min-h-screen bg-white dark:bg-gray-900 transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-12">
      <!-- Page Title -->
      <h1 class="text-hero-subtitle text-gray-900 dark:text-white mb-8">
        All Work
      </h1>

      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Tag Filter Sidebar (Desktop: left, Mobile: top) -->
        <aside class="lg:w-64 flex-shrink-0">
          <div class="lg:sticky lg:top-24">
            <h2 class="text-body font-semibold text-gray-900 dark:text-white mb-4">
              Filter by Tag
            </h2>

            <!-- All Categories Button -->
            <a
              href="/allWork"
              id="all-categories-btn"
              class="block px-4 py-2 mb-2 text-sm rounded-lg transition-colors duration-200 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700"
            >
              All Categories
            </a>

            <!-- Tag List -->
            <div class="flex flex-wrap lg:flex-col gap-2">
              {allTags.map((tag) => (
                <a
                  href={`/allWork?tag=${encodeURIComponent(tag)}`}
                  data-tag={tag}
                  class="tag-filter-btn block px-4 py-2 text-sm rounded-lg transition-colors duration-200 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700"
                >
                  {tag}
                </a>
              ))}
            </div>
          </div>
        </aside>

        <!-- Project Grid -->
        <div class="flex-1">
          <!-- Filter Status Message -->
          <p id="filter-status" class="text-body text-gray-600 dark:text-gray-400 mb-6 hidden">
            Showing projects tagged with <strong id="current-tag" class="text-gray-900 dark:text-white"></strong>
            (<span id="project-count">0</span> <span id="project-label">projects</span>)
          </p>

          <div id="project-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 gap-6">
            {sortedProjects.map((project) => (
              <div class="project-card" data-tags={JSON.stringify(project.data.tags)}>
                <Card
                  title={project.data.title}
                  coverImage={project.data.coverImage}
                  publishDate={project.data.publishDate}
                  category={project.data.category}
                  description={project.data.description}
                  tags={project.data.tags}
                  slug={project.slug}
                  lang={lang}
                />
              </div>
            ))}
          </div>

          <!-- No Results Message -->
          <div id="no-results" class="text-center py-12 hidden">
            <p class="text-body text-gray-500 dark:text-gray-400">
              No projects found with this tag.
            </p>
            <a
              href="/allWork"
              class="inline-block mt-4 px-6 py-3 text-sm font-semibold text-white bg-[#2B5288] rounded hover:bg-[#1e3b5f] transition-colors duration-300"
            >
              View All Projects
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  // Client-side tag filtering
  function filterProjects() {
    const urlParams = new URLSearchParams(window.location.search);
    const selectedTag = urlParams.get('tag');

    const projectCards = document.querySelectorAll('.project-card');
    const filterStatus = document.getElementById('filter-status');
    const currentTagEl = document.getElementById('current-tag');
    const projectCountEl = document.getElementById('project-count');
    const projectLabelEl = document.getElementById('project-label');
    const noResults = document.getElementById('no-results');
    const allCategoriesBtn = document.getElementById('all-categories-btn');
    const tagFilterBtns = document.querySelectorAll('.tag-filter-btn');

    let visibleCount = 0;

    if (selectedTag) {
      // Filter projects
      projectCards.forEach(card => {
        const tags = JSON.parse(card.dataset.tags || '[]');
        if (tags.includes(selectedTag)) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // Update UI
      if (visibleCount > 0) {
        filterStatus?.classList.remove('hidden');
        noResults?.classList.add('hidden');
        if (currentTagEl) currentTagEl.textContent = `"${selectedTag}"`;
        if (projectCountEl) projectCountEl.textContent = visibleCount.toString();
        if (projectLabelEl) projectLabelEl.textContent = visibleCount === 1 ? 'project' : 'projects';
      } else {
        filterStatus?.classList.add('hidden');
        noResults?.classList.remove('hidden');
      }

      // Highlight selected tag button
      allCategoriesBtn?.classList.remove('bg-black', 'dark:bg-white', 'text-white', 'dark:text-black', 'font-semibold');
      allCategoriesBtn?.classList.add('bg-gray-100', 'dark:bg-gray-800', 'text-gray-700', 'dark:text-gray-300');

      tagFilterBtns.forEach(btn => {
        if (btn.dataset.tag === selectedTag) {
          btn.classList.remove('bg-gray-100', 'dark:bg-gray-800', 'text-gray-700', 'dark:text-gray-300');
          btn.classList.add('bg-black', 'dark:bg-white', 'text-white', 'dark:text-black', 'font-semibold');
        } else {
          btn.classList.remove('bg-black', 'dark:bg-white', 'text-white', 'dark:text-black', 'font-semibold');
          btn.classList.add('bg-gray-100', 'dark:bg-gray-800', 'text-gray-700', 'dark:text-gray-300');
        }
      });
    } else {
      // Show all projects
      projectCards.forEach(card => {
        card.style.display = '';
      });
      filterStatus?.classList.add('hidden');
      noResults?.classList.add('hidden');

      // Highlight "All Categories" button
      allCategoriesBtn?.classList.remove('bg-gray-100', 'dark:bg-gray-800', 'text-gray-700', 'dark:text-gray-300');
      allCategoriesBtn?.classList.add('bg-black', 'dark:bg-white', 'text-white', 'dark:text-black', 'font-semibold');

      tagFilterBtns.forEach(btn => {
        btn.classList.remove('bg-black', 'dark:bg-white', 'text-white', 'dark:text-black', 'font-semibold');
        btn.classList.add('bg-gray-100', 'dark:bg-gray-800', 'text-gray-700', 'dark:text-gray-300');
      });
    }
  }

  // Run on page load
  filterProjects();
</script>
