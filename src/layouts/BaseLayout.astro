---
import '../styles/global.css';
import Head from '../components/Head.astro';

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'zh';
}

const { title, description = "Portfolio website", lang = 'en' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <Head title={title} description={description} lang={lang} />
  <body class="min-h-screen flex flex-col bg-white dark:bg-gray-900 text-gray-900 dark:prose-invert transition-colors duration-300">
    <slot />
  </body>
</html>
