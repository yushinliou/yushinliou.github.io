---
/**
 * Hero Component
 * Used in: Home page
 *
 * Structure per specification:
 * - Full-width GIF banner above content
 * - Two-column layout below banner:
 *   - Left: Text content (title, subtitle, description)
 *   - Right: SVG icons with hover tooltips (UC Berkeley, NTU, KTH logos)
 * - Center aligned on screen
 */

import heroBannerImg from "@/assets/hero/heroBanner.gif";

import { siteConfig } from '../config';
import berkeleyIcon from '@/assets/hero/icon-berkeley.png';
import berkeleyColoredIcon from '@/assets/hero/icon-berkeley-colored.png';
import kthIcon from '@/assets/hero/icon-kth.png';
import kthColoredIcon from '@/assets/hero/icon-kth-colored.png';
import ntuIcon from '@/assets/hero/icon-ntu.png';
import ntuColoredIcon from '@/assets/hero/icon-ntu-colored.png';
import wallLeft from '@/assets/hero/wall-left.svg';
import wallRight from '@/assets/hero/wall-right.svg';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;

// Institution icons with hover effect (grayscale to colored)
const institutions = [
  {
    name: 'KTH Royal Institute of Technology',
    location: 'Currently, I explore how to combine multiple models like sound, light, or haptics to create better interactive experiences',
    icon: kthIcon.src,
    iconColored: kthColoredIcon.src,
  },
  {
    name: 'UC Berkeley',
    location: 'I refined my interest in human–machine interaction through AI-focused research projects',
    icon: berkeleyIcon.src,
    iconColored: berkeleyColoredIcon.src,
  },
  {
    name: 'National Taiwan University',
    location: 'Where I built my foundation in human behavior research and programming',
    icon: ntuIcon.src,
    iconColored: ntuColoredIcon.src,
  },
];
---

<section class="hero-section w-full bg-room-green ">

  
<div class="flex flex-col lg:flex-row gap-0 items-stretch">


<!-- Wall Left: only show on large screen --> 
<div class="hidden lg:flex">
  <img 
    src={wallLeft.src} 
    alt="Wall Left" 
    class="h-96 -mt-10 z-50 dark:z-auto w-auto" 
  />
</div>

   <!-- Yellow box -->
  <div class="flex-1 px-16 lg:px-16 py-10 bg-amber-50 border-b-15 border-room-green border-x-15 md:border-x">

    <!-- Text Content -->
    <div class="space-y-4 mb-12 ">
      <h1 class="text-hero-title text-gray-900 font-semibold leading-tight ">
        {siteConfig.title}
      </h1>
      <p class="text-hero-subtitle text-gray-500 ">
        {siteConfig.description}
      </p>
      <p class="text-body text-gray-700 leading-relaxed max-w-4xl">
        {siteConfig.subdescription}
      </p>
    </div>

    <!-- Institution Icons Row -->
    <div class="flex flex-wrap items-center gap-8 lg:gap-10 ">
      {institutions.map((institution) => (
        <div class="institution-icon-wrapper group relative ">
          <div class="relative w-16 h-16 lg:w-20 lg:h-20 transition-transform duration-200 cursor-pointer ">
            <!-- Default grayscale icon -->
            <img
              src={institution.icon}
              alt={institution.name}
              class="absolute inset-0 w-full h-full object-contain transition-opacity duration-300 group-hover:opacity-0"
            />
            <!-- Colored icon on hover -->
            <img
              src={institution.iconColored}
              alt={institution.name}
              class="absolute inset-0 w-full h-full object-contain transition-opacity duration-300 opacity-0 group-hover:opacity-100"
            />
          </div>

          <!-- Tooltip -->
          <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-3 px-4 py-3 bg-gray-900 dark:bg-gray-700 text-white text-sm rounded-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pointer-events-none z-50 w-72 shadow-lg">
            <div class="text-xs text-gray-300 dark:text-gray-400 whitespace-normal leading-relaxed">{institution.location}</div>

            <!-- Arrow pointing down -->
            <div class="absolute top-full left-1/2 -translate-x-1/2">
              <div class="w-0 h-0 border-x-8 border-x-transparent border-t-8 border-t-gray-900 dark:border-t-gray-700"></div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
  
  <!-- Wall Right: only show on large screen --> 
  <div class="hidden lg:flex">
    <img src={wallRight.src} alt="Wall Right" class="h-96 -mt-10 z-50 dark:z-auto w-auto" />
  </div>
  
</div>

</section>
  <!-- Full-width GIF Banner -->
  <div class="w-full mb-12 bg-gray-100 dark:bg-gray-800">
    <img
      src={heroBannerImg.src}
      alt="Hero banner"
      class="w-full h-auto max-h-96 object-cover"
    />
  </div>
</section>

