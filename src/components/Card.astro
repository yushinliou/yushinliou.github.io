---
/**
 * Card Component
 * Used in: All Work page
 *
 * Displays a project card with:
 * - Cover image (16:9 aspect ratio)
 * - Title
 * - Publish date
 * - Category badge
 * - Description
 * - Tags (pill-shaped badges)
 *
 * Interactions:
 * - Hover: gray background + scale effect
 * - Click: Navigate to project page
 */

import { Image } from 'astro:assets';

interface Props {
  title: string;
  coverImage: {
    src: string;
    alt: string;
  };
  publishDate: Date;
  category: string;
  description: string;
  tags: string[];
  slug: string;
  lang?: string;
}

const { title, coverImage, publishDate, category, description, tags, slug, lang = 'en' } = Astro.props;

const projectUrl = lang === 'zh' ? `/zh/projects/${slug}` : `/projects/${slug}`;

// Format date
const formattedDate = publishDate.toLocaleDateString(lang === 'zh' ? 'zh-TW' : 'en-US', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<a href={projectUrl} class="card-link group block">
  <article class="card bg-white dark:bg-gray-800 rounded-lg overflow-hidden transition-all duration-300 hover:bg-gray-50 dark:hover:bg-gray-700 hover:scale-105 hover:shadow-lg">
    <!-- Cover Image -->
    <div class="aspect-video overflow-hidden">
      <img
        src={coverImage.src}
        alt={coverImage.alt}
        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-110"
        loading="lazy"
      />
    </div>

    <!-- Card Content -->
    <div class="p-5">
      <!-- Title -->
      <h3 class="text-card-title text-gray-900 dark:text-white mb-2 line-clamp-2">
        {title}
      </h3>

      <!-- Publish Date -->
      <p class="text-card-date text-gray-500 dark:text-gray-400 mb-2">
        {formattedDate}
      </p>

      <!-- Category Badge -->
      <span class="inline-block px-3 py-1 text-small font-medium bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded-full mb-3">
        {category}
      </span>

      <!-- Description -->
      <p class="text-card-description text-gray-700 dark:text-gray-300 mb-4 line-clamp-3">
        {description}
      </p>

      <!-- Tags -->
      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <button
              type="button"
              data-tag={tag}
              class="tag-button px-2 py-1 text-xs font-normal bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 rounded-full hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors duration-200"
              onclick={`event.preventDefault(); event.stopPropagation(); window.location.href='${lang === 'zh' ? '/zh' : ''}/allWork?tag=${encodeURIComponent(tag)}';`}
            >
              {tag}
            </button>
          ))}
        </div>
      )}
    </div>
  </article>
</a>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
