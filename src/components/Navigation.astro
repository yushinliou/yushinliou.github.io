---
/**
 * Navigation Bar Component
 *
 * Layout: [Avatar] Home All Work Research About CV [Languages ▾] [🌙/☀️]
 *
 * Features:
 * - Sticky position at top
 * - Translucent background with backdrop blur
 * - Avatar (40x40px circle) links to home
 * - Navigation links (active state: bold, hover: background gray)
 * - Theme toggle (moon/sun icon)
 * - Language switcher dropdown
 * - Responsive: hide language text on mobile
 */
import AvatarImage from '@/assets/avatar/avatar.png';
import { getLangFromUrl } from '../i18n/utils';
import { useTranslations } from '../i18n/translations';
import { siteConfig } from '../config';
import LanguageSwitcher from './LanguageSwitcher.astro';

const currentPath = Astro.url.pathname;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Define navigation items per specification
const navItems = [
  { name: t.nav.home, href: lang === 'zh' ? '/zh' : '/', key: 'home' },
  { name: t.nav.allWork, href: lang === 'zh' ? '/zh/allWork' : '/allWork', key: 'allwork' },
  { name: t.nav.research, href: lang === 'zh' ? '/zh/research' : '/research', key: 'research' },
  { name: t.nav.about, href: lang === 'zh' ? '/zh/about' : '/about', key: 'about' },
  { name: t.nav.cv, href: '/cv/cv.pdf', external: true, key: 'cv' },
];

const isActive = (href: string) => {
  if (href === '/' || href === '/zh') {
    return currentPath === href || currentPath === href + '/';
  }
  return currentPath.startsWith(href);
};
---

<nav class="navigation sticky top-0 w-full backdrop-blur-xs bg-room-green/50 dark:bg-gray-900/80 z-50 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between h-18">
      <!-- Left: Avatar -->
      <a href={lang === 'zh' ? '/zh' : '/'} class="flex-shrink-0" aria-label="Home">
        <img
          src={AvatarImage.src}
          alt="Avatar"
          class="w-10 h-8 rounded-full object-contain mr-1 hover:opacity-80 transition-opacity duration-200"
        />
      </a>

      <!-- Right: Nav Links, Language Switcher, Theme Toggle -->
      <div class="flex items-center gap-2 md:gap-4">
        <!-- Navigation Links -->
        <ul class="flex items-center gap-1 md:gap-2">
          {navItems.map((item) => (
            <li>
              {item.external ? (
                <a
                  href={item.href}
                  class="px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-gray-500 dark:hover:text-gray-500 rounded-lg transition-colors duration-200"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {item.name}
                </a>
              ) : (
                <a
                  href={item.href}
                  class={`px-3 py-2 text-sm transition-colors rounded-lg ${
                    isActive(item.href)
                      ? 'font-bold text-gray-900 dark:text-white'
                      : 'font-medium text-gray-700 dark:text-gray-300 hover:text-gray-500 dark:hover:text-gray-500'
                  }`}
                >
                  {item.name}
                </a>
              )}
            </li>
          ))}
        </ul>

        <!-- Language Switcher -->
        <LanguageSwitcher currentLang={lang} currentPath={currentPath} />
      </div>
    </div>
  </div>
</nav>

