---
// src/components/ProjectMeta.astro
interface Props {
  role: string;
  skills: string[];
  timeframe: string;
}

const { role, skills, timeframe } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12 p-6 bg-gray-50 dark:bg-gray-800 rounded-lg">
  <div>
    <h3 class="text-sm font-medium text-gray-500 dark:text-gray-400">
      Project role
    </h3>
    <p class="text-lg font-semibold text-gray-900 dark:text-white">
      {role}
    </p>
  </div>
  
  <div>
    <h3 class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-2">
      Key skills
    </h3>
    <div class="text-lg font-semibold text-gray-900 dark:text-white">
      {skills.map((skill) => (
        <p class="mb-1.5">{skill}</p>
      ))}
    </div>
  </div>
  
  <div>
    <h3 class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-2">
      Timeframe
    </h3>
    <div class="text-lg font-semibold text-gray-900 dark:text-white">
      {timeframe.split('\n').map((line) => (
        <p>{line}</p>
      ))}
    </div>
  </div>
</div>