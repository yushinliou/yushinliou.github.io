---
interface Stat {
  icon: string;
  label: string;
  value: string;
}

interface Props {
  name: string;
  level: number;
  title: string;
  bio: string;
  stats: Stat[];
  image?: string;
}

const { name, level, title, bio, stats, image } = Astro.props;
---

<section class="character-profile py-16 md:py-24 bg-white">
  <div class="max-w-5xl mx-auto px-8">
    <!-- Profile Header -->
    <div class="text-center mb-12">
      <div class="inline-block pixel-border border-4 border-black px-6 py-3 mb-4 bg-white">
        <h2 class="text-2xl md:text-3xl font-bold">
          {name} <span class="text-gray-600">Lvl {level}</span>
        </h2>
      </div>
      <p class="text-xl md:text-2xl text-gray-700 font-medium mb-4">
        {title}
      </p>
      <div class="max-w-2xl mx-auto">
        <p class="text-lg text-gray-600 leading-relaxed">
          {bio}
        </p>
      </div>
    </div>

    <!-- Health/Progress Bar (decorative) -->
    <div class="max-w-xl mx-auto mb-12">
      <div class="h-6 bg-gray-200 border-2 border-black pixel-border overflow-hidden">
        <div class="h-full bg-green-500 border-r-2 border-black" style="width: 85%;"></div>
      </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {stats.map((stat) => (
        <div class="stat-card border-2 border-black pixel-border p-6 bg-white hover:bg-gray-50 transition-colors">
          <div class="flex items-start gap-4">
            <div class="text-3xl flex-shrink-0">
              {stat.icon}
            </div>
            <div>
              <div class="font-bold text-lg mb-1">{stat.label}</div>
              <div class="text-gray-700">{stat.value}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .pixel-border {
    image-rendering: pixelated;
    image-rendering: -moz-crisp-edges;
    image-rendering: crisp-edges;
  }
</style>
