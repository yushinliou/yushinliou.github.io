---
import { Image } from 'astro:assets';
import confuseImg from '../assets/2025-01-22-The_Social_Code/flipcard-confuse.png';

interface Props {
  question: string;
  answer: string;
}

const { question, answer } = Astro.props;
---

<div class="flip-card-container my-8 mx-auto max-w-xl md:max-w-2xl lg:max-w-3xl" style="perspective: 1000px;">
  <div class="flip-card-inner relative cursor-pointer transition-transform duration-500">
    <!-- Front: Question -->
    <div class="flip-card-front absolute top-0 left-0 w-full h-full rounded-2xl flex items-center justify-center bg-white dark:bg-gray-800 shadow-lg hover:shadow-xl dark:shadow-2xl dark:hover:shadow-2xl transition-shadow">
      <div class="p-8 text-center flex flex-col items-center justify-center gap-3">
        <Image src={confuseImg} alt="Confused" class="w-[120px] h-auto mb-4" />
        <p class="text-xl font-semibold text-gray-900 dark:text-gray-100 leading-relaxed m-0">{question}</p>
        <p class="text-xs text-gray-500 dark:text-gray-400 m-0 mt-2 flex items-center gap-1.5">
          <i class="fas fa-lightbulb text-amber-500 dark:text-amber-400"></i>
          Click to reveal
        </p>
      </div>
    </div>

    <!-- Back: Answer -->
    <div class="flip-card-back absolute top-0 left-0 w-full h-full rounded-2xl flex items-center justify-center bg-white dark:bg-gray-800 shadow-lg hover:shadow-xl dark:shadow-2xl dark:hover:shadow-2xl transition-shadow">
      <div class="p-8 text-center flex flex-col items-center justify-center gap-3">
        <p class="text-base text-gray-700 dark:text-gray-300 leading-relaxed m-0">{answer}</p>
        <p class="text-xs text-gray-500 dark:text-gray-400 m-0 mt-2">Click to flip back</p>
      </div>
    </div>
  </div>
</div>

<style>
  /* 3D transform properties that can't be done with Tailwind */
  .flip-card-inner {
    transform-style: preserve-3d;
  }

  .flip-card-inner.flipped {
    transform: rotateY(180deg);
  }

  .flip-card-front,
  .flip-card-back {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .flip-card-back {
    transform: rotateY(180deg);
  }
</style>

<script>
  document.querySelectorAll('.flip-card-inner').forEach(card => {
    card.addEventListener('click', () => {
      card.classList.toggle('flipped');
    });
  });
</script>